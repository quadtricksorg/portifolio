# Copy to .env.local for local development, and set the same variables in your
# hosting provider (e.g. Vercel > Project > Settings > Environment Variables).

# --- Contact form email (required in production) ---
# Gmail: create an app password at https://myaccount.google.com/apppasswords
# (2-Step Verification must be on). Use the 16-character app password, not
# your normal Gmail password.
SMTP_USER=info.quadtricks@gmail.com
SMTP_PASS=
# Optional overrides (defaults shown)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Inbox that receives enquiries (defaults to the email in src/content/site.ts)
CONTACT_TO=info.quadtricks@gmail.com

# --- Spam protection (optional, recommended) ---
# Cloudflare Turnstile: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
